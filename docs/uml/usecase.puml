@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam usecaseBackgroundColor #EFF6FF
skinparam usecaseBorderColor #4779CA
skinparam ArrowColor #41546E
title COLORS — Use Case Diagram\nExisting-account lab workflow
actor "COLORS user" as User
rectangle "COLORS web application" {
  usecase "Log in" as Login
  usecase "Add a color" as Add
  usecase "Search saved colors" as Search
  usecase "Log out" as Logout
}
User -- Login
User -- Add
User -- Search
User -- Logout
note right of Login
  Existing MySQL account required.
  There is no registration page.
end note
note bottom of Add
  Adding and searching use the
  browser's current user ID.
end note
note bottom of Logout
  Clears cookie/user state and
  returns to index.html.
end note
@enduml
